    <worksheet name='D2 - Community Access Ranking'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000'>Highest and lowest station provision among matched communities</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='station_data' name='federated.1tdz16m1k36d0416l62jn0vkb722' />
          </datasources>
          <datasource-dependencies datasource='federated.1tdz16m1k36d0416l62jn0vkb722'>
            <column caption='Community Station Count ' datatype='integer' name='[Calculation_3395951723192347]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Community Area Number] :&#10;    COUNTD([station_id])&#10;}' />
            </column>
            <column caption='Stations per 10K residents' datatype='real' name='[Calculation_3395951723331612]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_3395951723192347]&#10;/&#10;{ FIXED [Community Area Number] : AVG([Population]) }&#10;* 10000' />
            </column>
            <column caption='Access Rank ' datatype='integer' name='[Calculation_6856117227024405]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RANK_UNIQUE(&#10;    AVG([Calculation_3395951723331612]),&#10;    &apos;desc&apos;&#10;)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Access Ranking Group ' datatype='string' name='[Calculation_6856117227200534]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_6856117227024405] &lt;= 5 THEN&#10;    &quot;Highest Access&quot;&#10;ELSEIF [Calculation_6856117227024405] &gt;&#10;    SIZE() - 6 THEN&#10;    &quot;Lowest Access&quot;&#10;ELSE&#10;    &quot;Other&quot;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='integer' name='[Community Area Number]' role='measure' type='quantitative' />
            <column datatype='string' name='[Community Area]' role='dimension' type='nominal' />
            <column datatype='real' name='[Population]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_3395951723331612]' derivation='Avg' name='[avg:Calculation_3395951723331612:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Community Area]' derivation='None' name='[none:Community Area:nk]' pivot='key' type='nominal' />
            <column caption='Station Id' datatype='integer' name='[station_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_6856117227200534]' derivation='User' name='[usr:Calculation_6856117227200534:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
              <table-calc field='[federated.1tdz16m1k36d0416l62jn0vkb722].[Calculation_6856117227024405]' ordering-type='Columns' />
            </column-instance>
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1tdz16m1k36d0416l62jn0vkb722].[usr:Calculation_6856117227200534:nk]'>
            <groupfilter function='union' user:ui-domain='relevant' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[usr:Calculation_6856117227200534:nk]' member='&quot;Highest Access&quot;' />
              <groupfilter function='member' level='[usr:Calculation_6856117227200534:nk]' member='&quot;Lowest Access&quot;' />
            </groupfilter>
          </filter>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.1tdz16m1k36d0416l62jn0vkb722].[none:Community Area:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.1tdz16m1k36d0416l62jn0vkb722].[avg:Calculation_3395951723331612:qk]' shelf='rows' />
          </shelf-sorts>
