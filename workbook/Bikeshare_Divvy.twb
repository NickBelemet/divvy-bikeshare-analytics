          <formatted-text>
            <run fontcolor='#4e79a7' fontsize='18'>Network Access &amp; Community Context </run>
          </formatted-text>
        </zone>
        <zone h='49004' id='5' name='D2 - Community access analysis' w='49759' x='48071' y='5275'>
          <layout-cache minwidth='152' type-h='fixed' type-w='scalable' />
        </zone>
        <zone h='16178' id='11' name='D2 - Community access analysis' pane-specification-id='0' param='[federated.1tdz16m1k36d0416l62jn0vkb722].[avg:Population:qk]' type-v2='size' w='10468' x='87149' y='13834' />
