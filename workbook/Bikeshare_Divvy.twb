        <zone h='41852' id='13' name='D2 - map' w='47749' x='241' y='7151'>
          <layout-cache minwidth='202' type-h='fixed' type-w='scalable' />
        </zone>
        <zone h='8910' id='14' name='D2 - map' pane-specification-id='0' param='[federated.0bimfjk1rhimm21fvrdlw0xkwobx].[avg:Walk Bike Commute %:qk]' type-v2='color' w='15149' x='32851' y='11020' />
        <zone h='42673' id='16' name='D2 - Community Access Ranking' w='47669' x='80' y='50762'>
          <layout-cache minwidth='248' type-h='fixed' type-w='scalable' />
        </zone>
        <zone forceUpdate='true' h='33411' id='17' type-v2='text' w='46624' x='50965' y='52169'>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontsize='10'>Active travel varies considerably across Chicago</run>
            <run fontcolor='#000000' fontsize='10'>, with higher walk/bike commuting concentrated in particular communities rather than evenly across the city. </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Station provision does not increase consistently with transport need.</run>
            <run fontcolor='#000000' fontsize='10'> Communities with a higher share of households without a vehicle show substantial variation in Divvy stations per 10K residents. </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Access is highly uneven across matched communities.</run>
            <run fontcolor='#000000' fontsize='10'> Fuller Park, Loop and Near West Side show considerably higher station provision per resident than communities such as Humboldt Park, Hermosa and Portage Park. </run>
            <run>Æ&#10;&#10;</run>
            <run bold='true' fontcolor='#000000' fontsize='10'>Network expansion should consider both demand and accessibility.</run>
            <run fontcolor='#000000' fontsize='10'> Communities with limited vehicle access but comparatively low Divvy provision represent useful candidates for further investigation.</run>
          </formatted-text>
        </zone>
        <zone h='2462' id='18' is-scaled='1' param='/Users/nick/Desktop/Rockborne/images.png' type-v2='bitmap' w='1849' x='48312' y='57679' />
