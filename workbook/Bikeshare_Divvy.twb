      <aliases enabled='yes' />
      <column caption='Selected Month - station' datatype='boolean' name='[Calculation_3395950460977174]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATE([activity_month]) &gt;= DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3395950209945607])&#10;AND&#10;DATE([activity_month]) &lt; DATEADD(&apos;month&apos;, 1, DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3395950209945607]))' />
      </column>
      <column caption='Net Flow Status' datatype='string' name='[Calculation_3395950476193815]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([net_station_flow]) &gt; 0 THEN&#10;    &quot;▲ Net Inflow&quot;&#10;ELSEIF SUM([net_station_flow]) &lt; 0 THEN&#10;    &quot;▼ Net Outflow&quot;&#10;ELSE&#10;    &quot;Balanced&quot;&#10;END' />
      </column>
      <column caption='Departures - Butterfly ' datatype='integer' name='[Calculation_3395951585624088]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='-SUM([departure_count])' />
      </column>
      <column caption='Community Station Count ' datatype='integer' name='[Calculation_3395951723192347]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Community Area Number] :&#10;    COUNTD([station_id])&#10;}' />
      </column>
      <column caption='Stations per 10K residents' datatype='real' name='[Calculation_3395951723331612]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_3395951723192347]&#10;/&#10;{ FIXED [Community Area Number] : AVG([Population]) }&#10;* 10000' />
      </column>
      <column caption='Cumulative Station Activity %' datatype='real' default-format='p0.00%' name='[Calculation_6856117045284880]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([total_station_activity]))&#10;/&#10;WINDOW_SUM(SUM([total_station_activity]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Access Rank ' datatype='integer' name='[Calculation_6856117227024405]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(&#10;    AVG([Calculation_3395951723331612]),&#10;    &apos;desc&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
