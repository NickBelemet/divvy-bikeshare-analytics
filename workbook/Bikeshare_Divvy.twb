      <column caption='Selected Month Trips' datatype='integer' name='[Calculation_3395950213263368]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF DATETRUNC(&apos;month&apos;, [trip_date])&#10;       = DATETRUNC(&apos;month&apos;, [Parameters].[Parameter 3395950209945607])&#10;    THEN [trip_count]&#10;    END&#10;)' />
